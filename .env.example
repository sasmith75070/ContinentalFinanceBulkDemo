# Twilio credentials
# Use an API Key (recommended) OR Auth Token; API Key is more scoped
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Demo sender (long code you already own) in E.164
TWILIO_FROM_LONGCODE=+1XXXXXXXXXX

# Messaging Service SID that owns TWILIO_FROM_LONGCODE and has Advanced Opt-Out configured
# Configured in Console: Messaging > Services > <your service> > Opt-Out
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Presenter's cell number in E.164 — the demo "customer" number
CUSTOMER_PHONE=+1XXXXXXXXXX

# Rehearsal safety: when true, all outbound skips CUSTOMER_PHONE and only sends to Magic Numbers
SAFE_MODE=false

# Public tunnel URL for inbound webhook (populate after `ngrok http 3000`)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok.io

# App
PORT=3000
